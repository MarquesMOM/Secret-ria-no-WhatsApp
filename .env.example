# --- WhatsApp Cloud API (developers.facebook.com > seu app > WhatsApp > Configuração da API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Uma senha que você inventa e coloca igual na configuração do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# Configurações do app > Básico > Chave secreta do app (valida que o webhook veio da Meta)
WHATSAPP_APP_SECRET=
REMINDER_TEMPLATE=aviso_secretaria
REMINDER_TEMPLATE_LANG=pt_BR

# Seu número pessoal, só dígitos com DDI e DDD (ex.: 5511999999999). Só ele conversa com a secretária.
OWNER_PHONE=

# --- Google Agenda (gerado por scripts/obter_token_google.py)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CALENDAR_ID=primary

# --- Claude (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Geral
TIMEZONE=America/Sao_Paulo
REMINDER_MINUTES_BEFORE=30
REMINDER_WINDOW_MINUTES=5
# Senha que o agendador envia para disparar lembretes e o resumo diário
TASKS_SECRET=
